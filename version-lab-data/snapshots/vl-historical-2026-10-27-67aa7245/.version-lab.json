{
  "appId": "comprehension",
  "repository": "nirav2000/Comprehension",
  "liveUrl": "https://nirav2000.github.io/Comprehension/",
  "productVersionFile": "version.json",
  "snapshotSafety": "visual-only",
  "snapshot": {
    "entry": "index.html",
    "exclude": [
      "version-lab-data",
      "version-lab-backfill-plan.json"
    ]
  },
  "platform": {
    "contract": "v1.7.0",
    "dependencies": [
      "auth/v1",
      "learning/v1",
      "learning-sync/v1",
      "pwa/v1",
      "app-monitor",
      "firebase-usage-monitor"
    ]
  },
  "data": {
    "provider": "Firebase Firestore, browser localStorage, Cloudflare Workers AI",
    "projectId": "kk-syllabus",
    "schemaVersion": "1",
    "paths": [
      "families/{parentUid}/learners/sai/events",
      "families/{parentUid}/learners/sai/approvedDevices",
      "learningSyncApps/comprehension/users/{uid}/learners/sai/chunks"
    ],
    "notes": "Archived snapshots are visual-only and must not access the production learner database."
  }
}
